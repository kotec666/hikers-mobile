{
  "expo": {
    "name": "hikers",
    "slug": "hikers",
    "locales": {
      "en": "./languages/en.json",
      "ru": "./languages/ru.json"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hikers",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0D0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "run.hikers.app",
      "icon": "./assets/images/icon-ios.icon",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.run.hikers.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "run.hikers.app",
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "quick_action_new_training": {
              "foregroundImage": "./assets/quick-actions/new-training.png",
              "backgroundColor": "#FFFFFF"
            },
            "quick_action_search": {
              "foregroundImage": "./assets/quick-actions/search.png",
              "backgroundColor": "#FFFFFF"
            },
            "quick_action_report_a_problem": {
              "foregroundImage": "./assets/quick-actions/report-a-problem.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Разрешите хайкерс доступ к датчикам устройства"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#252525"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Используем геолокацию для записи ваших тренировок и маршрутов",
          "locationAlwaysAndWhenInUsePermission": "Разрешение на фоновую геолокацию позволяет продолжать запись тренировки при заблокированном экране",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "react-native-yamap-plus",
        {
          "android_useYandexMapKitLite": true,
          "ios_useYandexMapKitLite": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          },
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению требуется доступ к вашей галерее для выбора изображения",
          "cameraPermission": "Приложению требуется доступ к вашей камере для добавления изображения"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "react-native-maps",
      "@bacons/apple-targets",
      "./plugins/with-live-activity-widget-embed-fix",
      "expo-status-bar",
      [
        "expo-native-sheet-emojis",
        {
          "searchLocales": [
            "en",
            "ru"
          ]
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42db0684-997b-4e27-bf0e-da3c6dc93f68"
      }
    }
  }
}
