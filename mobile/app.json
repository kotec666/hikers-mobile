{
	"expo": {
		"name": "хайкерс",
		"slug": "hikers",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "hikers",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#0D0D0D",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "run.hikers.app",
			"icon": "./assets/images/icon-ios.icon",
            "infoPlist": {
              "NSSupportsLiveActivities": true
            },
			"entitlements": {
				"com.apple.security.application-groups": ["group.run.hikers.app"]
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "run.hikers.app",
			"permissions": [
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.ACCESS_BACKGROUND_LOCATION",
				"android.permission.FOREGROUND_SERVICE",
				"android.permission.FOREGROUND_SERVICE_LOCATION",
				"android.permission.ACTIVITY_RECOGNITION"
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-sensors",
				{
					"motionPermission": "Разрешите хайкерс доступ к датчикам устройства"
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#252525"
				}
			],
			[
				"expo-location",
				{
					"locationAlwaysAndWhenInUsePermission": "Включите определение вашего местоположения для хайкерс в фоновом режиме",
                    "locationWhenInUsePermission": "Включите определение вашего местоположения для хайкерс в активном режиме",
					"isAndroidForegroundServiceEnabled": true,
					"isAndroidBackgroundLocationEnabled": true,
					"isIosBackgroundLocationEnabled": true
				}
			],
			[
				"expo-build-properties",
				{
					"android": {
						"kotlinVersion": "2.0.21",
						"compileSdkVersion": 36,
						"targetSdkVersion": 36,
						"minSdkVersion": 26,
						"buildArchs": ["arm64-v8a", "x86_64"],
						"enableMinifyInReleaseBuilds": true,
						"enableShrinkResourcesInReleaseBuilds": true,
						"enableBundleCompression": true
					}
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Приложению требуется доступ к вашей галерее для выбора изображения",
					"cameraPermission": "Приложению требуется доступ к вашей камере для добавления изображения"
				}
			],
			"expo-font",
			"expo-image",
			"expo-secure-store",
            "@bacons/apple-targets",
			"./plugins/with-live-activity-widget-embed-fix"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "42db0684-997b-4e27-bf0e-da3c6dc93f68"
			}
		}
	}
}
