{
	"name": "hikers",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start:dev": "expo start --dev-client",
		"start": "expo start",
		"start:withVPN": "expo start --tunnel",
		"optimize": "npx expo-optimize",
		"build": "expo prebuild && node ./scripts/withLocalProperties.js",
		"build:ios": "npx expo prebuild --platform ios",
		"doctor": "npx expo-doctor@latest --verbose",
		"build:eas:android": "eas build --platform android",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"format": "prettier --write \"{app,components,constants,helpers,hooks,scripts}/**/*.{js,jsx,ts,tsx}\""
	},
	"dependencies": {
		"@bacons/apple-targets": "^4.0.6",
		"@expo/ui": "~57.0.4",
		"@legendapp/list": "^3.3.2",
		"@legendapp/motion": "^2.5.3",
		"@quidone/react-native-wheel-picker": "^1.7.0",
		"@shopify/react-native-skia": "2.6.2",
		"@tanstack/react-query": "^5.90.21",
		"@typescript-eslint/eslint-plugin": "^8.40.0",
		"@typescript-eslint/parser": "^8.40.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"expo": "~57.0.4",
		"expo-application": "~57.0.0",
		"expo-blur": "~57.0.0",
		"expo-build-properties": "~57.0.3",
		"expo-clipboard": "~57.0.0",
		"expo-constants": "~57.0.3",
		"expo-dev-client": "~57.0.5",
		"expo-device": "~57.0.0",
		"expo-file-system": "^57.0.0",
		"expo-font": "~57.0.0",
		"expo-haptics": "~57.0.0",
		"expo-image": "~57.0.0",
		"expo-image-picker": "~57.0.2",
		"expo-linear-gradient": "~57.0.0",
		"expo-linking": "~57.0.2",
		"expo-location": "~57.0.2",
		"expo-native-sheet-emojis": "^2.1.2",
		"expo-network": "~57.0.0",
		"expo-quick-actions": "^6.0.1",
		"expo-router": "~57.0.4",
		"expo-secure-store": "~57.0.0",
		"expo-sensors": "~57.0.1",
		"expo-splash-screen": "~57.0.2",
		"expo-status-bar": "~57.0.0",
		"expo-task-manager": "~57.0.2",
		"ky": "^1.11.0",
		"nativewind": "^4.2.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.64.0",
		"react-native": "0.86.0",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-gesture-image-viewer": "^2.1.3",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-maps": "1.27.2",
		"react-native-mmkv": "4.0.1",
		"react-native-nitro-modules": "^0.33.9",
		"react-native-pager-view": "^8.0.2",
		"react-native-reanimated": "4.5.0",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "4.25.2",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.10.0",
		"react-native-yamap-plus": "^6.9.0",
