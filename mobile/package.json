{
  "name": "capacitor-app",
  "private": true,
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:runner",
    "build:runner": "cp src/background.js dist/assets/background.js && node ./scripts/runner_env_replace.mjs",
    "tsc": "tsc",
    "preview": "vite preview",
    "synchronize": "yarn build && npx cap sync",
    "android:start": "yarn build && npx cap sync && npx cap run android",
    "android:open": "yarn build && npx cap sync && npx cap open android",
    "ios:start": "yarn build && npx cap sync && npx cap run ios",
    "ios:open": "yarn build && npx cap sync && npx cap open ios",
    "sync:ios": "npx cap sync ios",
    "resources": "npx capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.22",
    "@capacitor/android": "^7.3.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/background-runner": "^2.1.0",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.3.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/geolocation": "^7.1.2",
    "@capacitor/ios": "^7.3.0",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@vitejs/plugin-react": "^4.5.2",
    "capacitor-native-settings": "^7.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.16.0",
    "ky": "^1.8.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.2",
    "sass": "^1.89.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.3.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@tailwindcss/forms": "^0.5.10",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.2"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
