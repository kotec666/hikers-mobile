{
	"name": "hikers",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start:dev": "expo start --dev-client",
		"start": "expo start",
		"start:withVPN": "expo start --tunnel",
		"optimize": "npx expo-optimize",
		"build": "expo prebuild",
		"doctor": "npx expo-doctor",
		"build:eas:android": "eas build --platform android",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"format": "prettier --write \"{app,components,constants,helpers,hooks,scripts}/**/*.{js,jsx,ts,tsx}\""
	},
	"dependencies": {
		"@notifee/react-native": "^9.1.8",
		"@typescript-eslint/eslint-plugin": "^8.40.0",
		"@typescript-eslint/parser": "^8.40.0",
		"clsx": "^2.1.1",
		"expo": "54.0.25",
		"expo-blur": "~15.0.7",
		"expo-build-properties": "~1.0.9",
		"expo-constants": "~18.0.10",
		"expo-dev-client": "^6.0.18",
		"expo-font": "~14.0.9",
		"expo-haptics": "~15.0.7",
		"expo-image": "~3.0.10",
		"expo-image-picker": "~17.0.8",
		"expo-linear-gradient": "~15.0.7",
		"expo-linking": "~8.0.9",
		"expo-location": "~19.0.7",
		"expo-notifications": "~0.32.13",
		"expo-router": "~6.0.15",
		"expo-splash-screen": "~31.0.11",
		"expo-status-bar": "~3.0.8",
		"expo-task-manager": "~14.0.8",
		"ky": "^1.11.0",
		"nativewind": "^4.1.23",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.64.0",
		"react-native": "0.81.5",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-gifted-charts": "^1.4.64",
		"react-native-mmkv": "4.0.1",
		"react-native-nitro-modules": "^0.31.8",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-svg": "15.12.1",
		"react-native-worklets": "0.5.1",
		"react-native-yamap-plus": "^5.3.6",
		"tailwind-merge": "^3.3.1",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@react-native-community/cli": "latest",
		"@types/react": "~19.1.10",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-unused-imports": "^4.2.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"tailwindcss": "^3.4.17",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.40.0"
	},
	"private": true,
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"exclude": [
					"react-native-yamap-plus"
				],
				"listUnknownPackages": false
			}
		}
